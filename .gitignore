# Data: never commit the NHS files, the clean Parquet or the warehouse
data/raw/*
data/clean/*
warehouse/*
raw/

# Keep the empty-folder markers and the manifest
!data/raw/.gitkeep
!data/clean/.gitkeep
!warehouse/.gitkeep
!data/raw/manifest.json

# Logs
logs/
*.log

# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints

# Virtual environments and secrets
.venv/
venv/
env/
.env
